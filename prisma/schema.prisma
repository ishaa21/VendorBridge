generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  VENDOR
  MANAGER
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum RFQStatus {
  DRAFT
  OPEN
  VENDOR_RESPONSES_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum POStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  DISPUTED
  CANCELLED
}

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?
  passwordHash    String
  role            Role      @default(VENDOR)
  country         String?
  profileImage    String?
  additionalInfo  String?   @db.Text
  emailVerified   DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  vendor              Vendor?
  createdVendors      Vendor[]              @relation("VendorCreator")
  rfqs                RFQ[]
  approvals           Approval[]
  vendorStatusChanges VendorStatusHistory[]
  comparisonDecisions ComparisonDecision[]
  initiatedWorkflows  ApprovalWorkflow[]    @relation("WorkflowInitiator")
  approvalSteps       ApprovalStep[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  actionType  String?
  module      String?
  entityType  String?
  entityId    String?
  description String?  @db.Text
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Vendor {
  id            String       @id @default(cuid())
  userId        String?      @unique
  vendorName    String
  companyName   String
  category      String
  gstNumber     String       @unique
  panNumber     String
  contactPerson String
  phone         String
  email         String       @unique
  address       String       @db.Text
  country       String
  status        VendorStatus @default(PENDING)
  notes         String?      @db.Text
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("VendorCreator", fields: [createdById], references: [id])
  rfqInvitations RFQVendor[]
  quotations     Quotation[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  statusHistory       VendorStatusHistory[]
  comparisonDecisions ComparisonDecision[]

  @@map("vendors")
}

model VendorStatusHistory {
  id          String       @id @default(cuid())
  vendorId    String
  fromStatus  VendorStatus
  toStatus    VendorStatus
  changedById String
  reason      String?      @db.Text
  createdAt   DateTime     @default(now())

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([vendorId])
  @@index([changedById])
  @@map("vendor_status_history")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model RFQ {
  id           String          @id @default(cuid())
  rfqNumber    String          @unique
  title        String
  category     String
  description  String          @db.Text
  deadline     DateTime
  status       RFQStatus       @default(DRAFT)
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy    User            @relation(fields: [createdById], references: [id])
  items        RFQItem[]
  invited      RFQVendor[]
  attachments        RFQAttachment[]
  quotations         Quotation[]
  comparisonDecision ComparisonDecision?
  approvalWorkflow   ApprovalWorkflow?
  purchaseOrders     PurchaseOrder[]

  @@index([createdById])
  @@map("rfqs")
}

model RFQItem {
  id             String   @id @default(cuid())
  rfqId          String
  itemName       String
  quantity       Decimal  @db.Decimal(12, 4)
  unit           String
  estimatedPrice Decimal? @db.Decimal(15, 2)
  specifications String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rfq            RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@map("rfq_items")
}

model RFQVendor {
  id         String   @id @default(cuid())
  rfqId      String
  vendorId   String
  assignedAt DateTime @default(now())

  rfq        RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@map("rfq_vendors")
}

model RFQAttachment {
  id         String   @id @default(cuid())
  rfqId      String
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())

  rfq        RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@map("rfq_attachments")
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  rfqId           String
  vendorId        String
  subtotal        Decimal         @db.Decimal(15, 2)
  taxRate         Decimal         @db.Decimal(5, 2)
  taxAmount       Decimal         @db.Decimal(15, 2)
  grandTotal      Decimal         @db.Decimal(15, 2)
  notes           String?         @db.Text
  status          QuotationStatus @default(DRAFT)
  submittedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rfq            RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items              QuotationItem[]
  purchaseOrders     PurchaseOrder[]
  comparisonDecision ComparisonDecision?
  approvalWorkflows  ApprovalWorkflow[]

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
  @@map("quotations")
}

model QuotationItem {
  id           String   @id @default(cuid())
  quotationId  String
  itemName     String
  quantity     Decimal  @db.Decimal(12, 4)
  unitPrice    Decimal  @db.Decimal(15, 2)
  total        Decimal  @db.Decimal(15, 2)
  deliveryDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Approval {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  approverId  String
  status      ApprovalStatus @default(PENDING)
  comments    String?        @db.Text
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  approver User @relation(fields: [approverId], references: [id])

  @@index([approverId])
  @@index([entityType, entityId])
  @@map("approvals")
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  poNumber     String   @unique
  rfqId        String?
  quotationId  String
  vendorId     String
  totalAmount  Decimal  @db.Decimal(15, 2)
  amount       Decimal? @db.Decimal(15, 2)
  status       POStatus @default(DRAFT)
  deliveryDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  rfq       RFQ?      @relation(fields: [rfqId], references: [id])
  invoices  Invoice[]

  @@index([quotationId])
  @@index([vendorId])
  @@index([rfqId])
  @@map("purchase_orders")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  poId          String
  vendorId      String
  amount        Decimal       @db.Decimal(15, 2)
  subtotal      Decimal?      @db.Decimal(15, 2)
  cgst          Decimal?      @db.Decimal(15, 2)
  sgst          Decimal?      @db.Decimal(15, 2)
  grandTotal    Decimal?      @db.Decimal(15, 2)
  status        InvoiceStatus @default(DRAFT)
  paymentStatus String?       @default("PENDING_PAYMENT")
  dueDate       DateTime
  attachments   String?       @db.Text
  generatedAt   DateTime?     @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  vendor        Vendor        @relation(fields: [vendorId], references: [id])

  @@index([poId])
  @@index([vendorId])
  @@map("invoices")
}

model ComparisonDecision {
  id                  String   @id @default(cuid())
  rfqId               String   @unique
  selectedVendorId    String
  selectedQuotationId String   @unique
  recommendationScore Decimal  @db.Decimal(5, 2)
  manualOverrideReason String?  @db.Text
  selectedById        String
  createdAt           DateTime @default(now())

  rfq               RFQ       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  selectedVendor    Vendor    @relation(fields: [selectedVendorId], references: [id], onDelete: Cascade)
  selectedQuotation Quotation @relation(fields: [selectedQuotationId], references: [id], onDelete: Cascade)
  selectedBy        User      @relation(fields: [selectedById], references: [id])

  @@index([rfqId])
  @@index([selectedVendorId])
  @@index([selectedQuotationId])
  @@index([selectedById])
  @@map("comparison_decisions")
}

model ApprovalWorkflow {
  id            String   @id @default(cuid())
  rfqId         String   @unique
  quotationId   String
  currentStage  String   @default("L1_REVIEW") // L1_REVIEW, L2_APPROVAL, GENERATE_PO, COMPLETED, REJECTED
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, ESCALATED
  initiatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rfq         RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  initiatedBy User           @relation("WorkflowInitiator", fields: [initiatedById], references: [id])
  steps       ApprovalStep[]

  @@index([rfqId])
  @@index([quotationId])
  @@index([initiatedById])
  @@map("approval_workflows")
}

model ApprovalStep {
  id         String    @id @default(cuid())
  workflowId String
  approverId String
  stage      String    // L1_REVIEW, L2_APPROVAL, L3_EXECUTIVE
  remarks    String?   @db.Text
  decision   String    @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approver   User             @relation(fields: [approverId], references: [id])

  @@index([workflowId])
  @@index([approverId])
  @@map("approval_steps")
}
